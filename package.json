{
  "name": "unicorn-launch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UNICORN LAUNCH — инвестиционная платформа российского ОИП (монорепо)",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "database"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build -w apps/core --if-present && npm run build -w apps/web-public --if-present && npm run build -w apps/admin --if-present && npm run build -w apps/lab --if-present && npm run build -w apps/investor --if-present && npm run build -w apps/expert --if-present && npm run build -w apps/auth --if-present",
    "build:console": "npm run build -w apps/console",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "test": "npm run build:packages && npm run test --workspaces --if-present",
    "infra:up": "node scripts/infra.mjs up",
    "web:up": "node scripts/infra.mjs web-up",
    "web:down": "node scripts/infra.mjs web-down",
    "infra:down": "node scripts/infra.mjs down",
    "infra:reset": "node scripts/infra.mjs reset",
    "db:migrate": "npm run migrate -w database",
    "demo:load": "node scripts/seed-demo.mjs load",
    "demo:clean": "node scripts/seed-demo.mjs clean",
    "demo:status": "node scripts/seed-demo.mjs status",
    "gate:ports": "node scripts/check-ports-consistency.mjs",
    "gate:console-private": "node scripts/check-console-private.mjs",
    "gate:secrets": "gitleaks detect --no-banner --redact --config .gitleaks.toml",
    "secrets:redactors": "node scripts/build-local-redactors.mjs",
    "gate:redactors": "node scripts/build-local-redactors.mjs --check",
    "probe:secret-leak": "node scripts/probe-secret-leak.mjs",
    "rotate:kek": "node scripts/rotate-kek.mjs",
    "gate:deps": "npm audit --audit-level=high",
    "gate:secret-reuse": "node scripts/check-secret-reuse.mjs",
    "gate:kek": "node scripts/check-kek-domains.mjs",
    "gate:roles-env": "node scripts/check-role-env-consistency.mjs",
    "gate:sast-config": "node scripts/check-sast-config.mjs",
    "gate:checkpoint-secrets": "node scripts/check-checkpoint-secrets.mjs",
    "gate:ssh-keys": "node scripts/check-ssh-keys.mjs",
    "ssh:install-key": "python scripts/ssh-key-install.py",
    "rotate:stand-secrets": "node scripts/rotate-stand-secrets.mjs",
    "gate:net": "node scripts/network-audit.mjs",
    "gate:net:strict": "node scripts/network-audit.mjs --strict",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run gate:boundary && npm run gate:deps && npm run gate:secret-reuse && npm run gate:kek && npm run gate:roles-env && npm run gate:sast-config && npm run gate:ssh-keys && npm run gate:ai && npm run gate:net:strict",
    "gate:boundary": "node scripts/check-frontend-boundary.mjs",
    "build:packages": "npm run build -w packages/contracts && npm run build -w packages/ui && npm run build -w packages/cabinet && npm run build -w packages/api-client",
    "gate:ai": "node scripts/gate-ai-gateway.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
