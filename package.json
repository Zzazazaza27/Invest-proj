{
  "name": "unicorn-launch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "UNICORN LAUNCH — инвестиционная платформа российского ОИП (монорепо)",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "database",
    "e2e"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "npm run test --workspaces --if-present",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "db:migrate": "npm run migrate -w database",
    "db:seed": "npm run seed -w database",
    "gate:secrets": "gitleaks detect --no-banner --redact --config .gitleaks.toml",
    "gate:deps": "npm audit --audit-level=high",
    "gate:net": "node scripts/network-audit.mjs",
    "gate": "npm run lint && npm run typecheck && npm run test && npm run gate:deps && npm run gate:net"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
