#!/bin/sh
#
# Ворота перед отправкой: не запушить поверх чужой работы.
#
# Репозиторий — rebel-diesel/fifth-element. Пока идёт работа, в origin мог лечь
# чужой коммит (сторонний доступ, агент, правка через сайт GitHub), и push поверх
# него смешает изменения так, что потом их не разделить.
#
# Хук не запрещает чужие коммиты, а останавливает отправку до того, как их
# заметили. Разобрались и признали законными — впишите автора в OWNERS в
# scripts/check-upstream-owner.mjs. Обходить весь хук (--no-verify) ради одной
# проверки нельзя: с 10.11.2026 он держит и скан секретов, и гейт ключей .ssh/.
#
# Ставится через `npm run hooks:install` (и сам собой при `npm install`).

# Без Node не выполняется ни одна проверка, в том числе скан секретов: отправка
# останавливается, а не пропускается молча (Тэнк 10.11).
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node не найден — проверки не выполнены, отправка остановлена" >&2
  exit 1
fi

# Ввод хука (какие коммиты уходят) нужен второй проверке — сохраняем его.
refs=$(cat)

node scripts/check-upstream-owner.mjs || {
  echo "" >&2
  echo "PUSH ОСТАНОВЛЕН: в origin есть коммиты не от вас (см. выше)." >&2
  echo "Признаны законными — автора в OWNERS (scripts/check-upstream-owner.mjs)." >&2
  exit 1
}

# Быстрая проверка изменённых файлов: prettier, eslint, semgrep guardian.
# До неё первые проверки кода запускались только в CI (2026-09-24).
printf '%s\n' "$refs" | node scripts/check-pre-push.mjs || exit 1

# Скан секретов уходящих коммитов (gitleaks в Docker, тот же образ и правила, что workflow
# «Секреты»). С 10.11.2026 на GitHub он идёт раз в неделю, а на каждый push — здесь
# (решение Томаса: минуты Actions). Нет Docker — отправка остановлена.
printf '%s\n' "$refs" | node scripts/check-secrets-pre-push.mjs || exit 1

# Приватные SSH-ключи не покидают локальную папку `.ssh/` (Ф58) — раньше этот гейт на push
# держал только workflow «Секреты».
ssh_out=$(node scripts/check-ssh-keys.mjs 2>&1) || {
  printf '%s\n' "$ssh_out" >&2
  echo "pre-push: ОСТАНОВЛЕНО — гейт «ключи не покидают .ssh/»." >&2
  exit 1
}

exit 0
