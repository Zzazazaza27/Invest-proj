#!/bin/sh
#
# Ворота перед отправкой: не запушить поверх чужой работы.
#
# Репозиторий принадлежит прежнему исполнителю, доступ у него остался. Пока
# идёт работа, в origin мог лечь чужой коммит — и push поверх него смешает
# изменения так, что потом их не разделить.
#
# Хук не запрещает чужие коммиты, а останавливает отправку до того, как их
# заметили. Разобрались и признали законными — либо впишите автора в OWNERS
# в scripts/check-upstream-owner.mjs, либо отправьте с --no-verify.
#
# Ставится через `npm run hooks:install` (и сам собой при `npm install`).

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node не найден — проверка владельца пропущена" >&2
  exit 0
fi

node scripts/check-upstream-owner.mjs || {
  echo "" >&2
  echo "PUSH ОСТАНОВЛЕН: в origin есть коммиты не от вас (см. выше)." >&2
  echo "Отправить всё равно: git push --no-verify" >&2
  exit 1
}

exit 0
