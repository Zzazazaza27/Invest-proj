{
  "name": "@unicorn/core",
  "private": true,
  "version": "0.1.0",
  "description": "UNICORN LAUNCH core — модульный монолит NestJS: единственный владелец БД и бизнес-правил",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@nestjs/common": "^11.1.29",
    "@nestjs/core": "^11.1.29",
    "@nestjs/platform-fastify": "^11.1.29",
    "@unicorn/contracts": "*",
    "argon2": "^0.41.1",
    "ioredis": "5.11.1",
    "jose": "^5.9.6",
    "nats": "2.29.3",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@swc/core": "^1.10.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.1.10"
  }
}
