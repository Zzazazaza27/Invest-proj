{
  "name": "@fifth/cabinet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Общие продуктовые блоки кабинетов: то, что обязано выглядеть и вести себя одинаково у основателя, инвестора и эксперта",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
