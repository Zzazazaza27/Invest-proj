  "dependencies": {
    "@fifth/contracts": "*",
    "@fifth/ui": "*"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
