{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "dist",
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "paths": { "@unicorn/contracts": ["../contracts/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
