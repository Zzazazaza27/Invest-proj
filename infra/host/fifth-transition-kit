#!/bin/sh
# Переходный комплект (блок 5, задание 5): всё, что нужно ядру с местными ключами.
#
#   fifth-transition-kit create    снять .env и каталог секретов, зашифровать на ключ Томаса
#   fifth-transition-kit restore   вернуть их: поток tar на вход, после проверки описи
#
# Прежнего .env для возврата мало: в нём только пути <ИМЯ>_FILE, а сами KEK лежат файлами со своими
# владельцами и правами. Комплект хранит всё вместе, опись проверяет содержимое и права.
# Значения не печатаются. Запускается от root; пути задаются только для проверок.
set -eu
umask 077
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

ROOT="${FIFTH_TRANSITION_ROOT:-/opt/fifth-element}"
KEYS="${FIFTH_OPENBAO_KEYS_DIR:-/var/backups/fifth-element/openbao-keys}"
RECIPIENT="${FIFTH_OPENBAO_RECIPIENT:-$ROOT/infra/openbao/thomas-recipient.asc}"
RECIPIENT_FPR="${FIFTH_OPENBAO_RECIPIENT_FPR:-06D54B5532998568A88185A2BEA53785936C28C0}"
ENV_FILE="${FIFTH_TRANSITION_ENV:-.env}"
OPENBAO_SECRETS="${FIFTH_TRANSITION_SECRETS:-.local/secrets}"

fail() {
  echo "fifth-transition-kit: $1" >&2
  exit 1
}

# Опись: тип, права, владелец и хеш каждого файла и каталога, включая сам каталог секретов.
# Ссылки и всё, кроме обычных файлов и каталогов, помечаются «!»: комплект таких не принимает.
manifest() {
  (cd "$1" && find "$ENV_FILE" "$OPENBAO_SECRETS" -printf '%y %m %U %G %n %p\n' | LC_ALL=C sort -k6 |
    while read -r type mode uid gid links name; do
      case "$type" in
        f)
          [ "$links" = 1 ] || { echo "! $name"; continue; }
          echo "f $mode $uid $gid $(sha256sum "$name" | cut -d' ' -f1) $name"
          ;;
        d) echo "d $mode $uid $gid - $name" ;;
        *) echo "! $name" ;;
      esac
    done)
}

# Набор обязан быть полным: .env файлом, каталог секретов каталогом, и ничего лишнего.
sound() {
  ! grep -q '^!' "$1" && grep -q "^f .* $ENV_FILE\$" "$1" && grep -q "^d .* $OPENBAO_SECRETS\$" "$1"
}

create() {
  [ -f "$ROOT/$ENV_FILE" ] || fail 'нет файла настроек'
  [ -d "$ROOT/$OPENBAO_SECRETS" ] || fail 'нет каталога секретов'
  work="$(mktemp -d)"
  trap 'rm -rf "$work"' EXIT
  gpg --homedir "$work" --batch -q --import <"$RECIPIENT" 2>/dev/null
  fpr="$(gpg --homedir "$work" --batch --list-keys --with-colons | awk -F: '/^fpr/{print $10; exit}')"
  [ "$fpr" = "$RECIPIENT_FPR" ] || fail 'открытый ключ не тот: комплект не создан'
  mkdir -p "$KEYS"
  manifest "$ROOT" >"$work/transition-manifest.txt"
  sound "$work/transition-manifest.txt" || fail 'есть ссылки или нет нужных файлов: комплект не создан'
  files="$(grep -c '^f ' "$work/transition-manifest.txt")"
  # У sh нет pipefail: сбой tar отмечается файлом, иначе в комплект молча уйдёт обрывок.
  (cd "$ROOT" && tar -cpf - --numeric-owner "$ENV_FILE" "$OPENBAO_SECRETS" -C "$work" transition-manifest.txt ||
    touch "$work/tar.failed") |
    gpg --homedir "$work" --batch -q --trust-model always --encrypt --recipient "$fpr" \
      --output - >"$KEYS/transition.gpg.tmp"
  [ ! -e "$work/tar.failed" ] || fail 'архив не собран: комплект не создан'
  mv "$KEYS/transition.gpg.tmp" "$KEYS/transition.gpg"
  printf '{"recipient":"%s","kitSha256":"%s","manifestSha256":"%s","files":%s,"at":"%s"}\n' \
    "$fpr" "$(sha256sum "$KEYS/transition.gpg" | cut -d' ' -f1)" \
    "$(sha256sum "$work/transition-manifest.txt" | cut -d' ' -f1)" "$files" \
    "$(date -u +%FT%TZ)" >"$KEYS/transition.json"
  echo "комплект создан, файлов: $files"
}

restore() {
  stage="$(mktemp -d "$ROOT/.transition-XXXXXX")"
  trap 'rm -rf "$stage"' EXIT
  tar -xpf - --numeric-owner -C "$stage"
  [ -s "$stage/transition-manifest.txt" ] || fail 'в комплекте нет описи'
  # Опись снята при создании: после распаковки всё обязано совпасть, включая права и владельца.
  (cd "$stage" && mv transition-manifest.txt ../.transition-manifest.$$)
  manifest "$stage" >"$ROOT/.transition-actual.$$"
  if ! sound "$ROOT/.transition-actual.$$" ||
    ! cmp -s "$ROOT/.transition-manifest.$$" "$ROOT/.transition-actual.$$"; then
    rm -f "$ROOT/.transition-manifest.$$" "$ROOT/.transition-actual.$$"
    fail 'содержимое не совпало с описью: ничего не изменено'
  fi
  files="$(grep -c '^f ' "$ROOT/.transition-actual.$$")"
  rm -f "$ROOT/.transition-manifest.$$" "$ROOT/.transition-actual.$$"
  aside="$ROOT/.local/before-restore-$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$aside"
  [ ! -e "$ROOT/$ENV_FILE" ] || mv "$ROOT/$ENV_FILE" "$aside/$ENV_FILE"
  [ ! -e "$ROOT/$OPENBAO_SECRETS" ] || mv "$ROOT/$OPENBAO_SECRETS" "$aside/secrets"
  mv "$stage/$ENV_FILE" "$ROOT/$ENV_FILE"
  mv "$stage/$OPENBAO_SECRETS" "$ROOT/$OPENBAO_SECRETS"
  echo "восстановлено файлов: $files, прежнее отложено"
}

case "${1:-}" in
  create) create ;;
  restore) restore ;;
  *)
    echo 'команды: create, restore' >&2
    exit 2
    ;;
esac
