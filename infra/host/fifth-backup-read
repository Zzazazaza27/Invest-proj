#!/usr/bin/node
'use strict';
/*
 * Чтение резервных копий для учётки maus (блок 5, шаг 3.0). Запускается через sudo.
 *
 *   fifth-backup-read latest          имя последнего готового комплекта
 *   fifth-backup-read pilot-latest    последняя копия пилотной среды
 *   fifth-backup-read pilot-file <копия>/<файл>  файл этой копии, зашифрованный
 *   fifth-backup-read pilot-ack <копия>  отметка: копия сохранена вне сервера
 *   fifth-backup-read has <комплект>  имя, если комплект готов
 *   fifth-backup-read catalog <комплект>
 *   fifth-backup-read tar <комплект>  поток tar: только файлы описи комплекта
 *   fifth-backup-read openbao-keys       зашифрованный аварийный комплект OpenBao
 *   fifth-backup-read openbao-keys-meta  его описание, без значений
 *   fifth-backup-read transition-kit       зашифрованный переходный комплект
 *   fifth-backup-read transition-kit-meta  его описание, без значений
 *   fifth-backup-read audit-list <среда>  порции выгрузки аудита (2.1.5): prod | test-2
 *   fifth-backup-read audit-file <среда>/<имя>  порция: NNNNNN.jsonl.gpg | .manifest.json | .manifest.sig
 *   fifth-backup-read audit-ack <среда>:<N>@<покрыто до>  отметка: порция N сохранена вне сервера
 *
 * Пути снаружи не принимаются: список файлов берётся из описи комплекта и проверяется.
 * Каталог задаётся переменной только для проверок без root.
 */
const { spawn } = require('node:child_process');
const fs = require('node:fs');
const path = require('node:path');

const isRoot = typeof process.getuid === 'function' && process.getuid() === 0;
const ROOT = fs.realpathSync(
  isRoot ? '/var/backups/fifth-element' : process.env.FIFTH_BACKUP_READ_ROOT || '.',
);
const TAR = isRoot ? '/usr/bin/tar' : 'tar';
const SET_ID = /^[0-9TZ]+-[0-9a-f]+$/;

function fail(message) {
  console.error(`fifth-backup-read: ${message}`);
  process.exit(2);
}

function readySet(id) {
  if (typeof id !== 'string' || !SET_ID.test(id)) fail('неверное имя комплекта');
  const ready = path.join(ROOT, 'sets', id, 'READY');
  if (!fs.existsSync(ready)) fail('комплект не готов');
  return id;
}

function catalogOf(id) {
  return JSON.parse(fs.readFileSync(path.join(ROOT, 'sets', id, 'catalog.json'), 'utf8'));
}

function checked(rel) {
  if (typeof rel !== 'string' || !rel || rel.includes('\0')) fail('неверный путь в описи');
  if (path.isAbsolute(rel) || rel.split(/[\\/]/).includes('..')) fail(`путь вне копий: ${rel}`);
  const full = path.join(ROOT, rel);
  const stat = fs.lstatSync(full, { throwIfNoEntry: false });
  if (!stat || !stat.isFile()) fail(`не обычный файл: ${rel}`);
  const real = fs.realpathSync(full);
  if (!real.startsWith(ROOT + path.sep)) fail(`путь вне копий: ${rel}`);
  return rel;
}

const [command, id, ...extra] = process.argv.slice(2);
if (extra.length) fail('лишние аргументы');

const PILOT = path.join(ROOT, 'pilot', 'test-2');
const pilotSets = () =>
  fs.existsSync(PILOT)
    ? fs
        .readdirSync(PILOT)
        .filter((s) => /^[0-9TZ]+$/.test(s) && fs.existsSync(path.join(PILOT, s, 'READY')))
        .sort()
    : [];

if (command === 'pilot-latest') {
  if (id !== undefined) fail('лишние аргументы');
  process.stdout.write(`${pilotSets().pop() ?? ''}\n`);
} else if (command === 'pilot-file') {
  // Имя файла задаёт только этот список: путь снаружи не принимается.
  const [set, name] = String(id).split('/');
  if (!pilotSets().includes(set)) fail('нет такой копии');
  if (
    !['manifest.json', 'db.dump.gpg', 'roles.sql.gpg', 'files.tar.gpg', 'env.tar.gpg'].includes(
      name,
    )
  ) {
    fail('неверное имя файла');
  }
  fs.createReadStream(path.join(PILOT, set, name)).pipe(process.stdout);
} else if (command === 'pilot-ack') {
  // Единственная запись: имя готовой копии и время, в файл наблюдения.
  if (!pilotSets().includes(id)) fail('нет такой копии');
  const state = isRoot ? '/var/lib/fifth-monitor' : ROOT;
  fs.writeFileSync(
    path.join(state, 'pilot-offsite.json'),
    `${JSON.stringify({ at: new Date().toISOString(), set: id })}\n`,
  );
} else if (command === 'audit-list' || command === 'audit-file' || command === 'audit-ack') {
  // Выгрузка журнала аудита (2.1.5): порции только читаются; среда — из перечня, имена —
  // строго по шаблону.
  const ENVS = ['prod', 'test-2'];
  const NAME = /^[0-9]{6}\.(jsonl\.gpg|manifest\.json|manifest\.sig)$/;
  const [envId, rest] = String(id).split(/[/:](.*)/s);
  if (!ENVS.includes(envId)) fail('неизвестная среда');
  const AUDIT = isRoot
    ? `/var/lib/fifth-audit-export/${envId}/out`
    : path.join(ROOT, 'audit-out', envId);
  if (command === 'audit-list') {
    if (rest !== undefined) fail('лишние аргументы');
    const names = fs.existsSync(AUDIT) ? fs.readdirSync(AUDIT).filter((n) => NAME.test(n)) : [];
    process.stdout.write(names.sort().join('\n') + (names.length ? '\n' : ''));
  } else if (command === 'audit-file') {
    if (!NAME.test(String(rest))) fail('неверное имя порции');
    const full = path.join(AUDIT, rest);
    const stat = fs.lstatSync(full, { throwIfNoEntry: false });
    if (!stat || !stat.isFile()) fail('нет такой порции');
    fs.createReadStream(full).pipe(process.stdout);
  } else {
    // Единственная запись: номер порции и покрытие, проверенные на стороне выноса.
    const [seq, covered] = String(rest).split('@');
    if (!/^[0-9]{1,6}$/.test(seq) || Number.isNaN(Date.parse(covered ?? ''))) {
      fail('нужно <среда>:<номер>@<покрыто до>');
    }
    const manifest = path.join(AUDIT, `${seq.padStart(6, '0')}.manifest.json`);
    if (!fs.existsSync(manifest)) fail('нет такой порции');
    const real = JSON.parse(fs.readFileSync(manifest, 'utf8'));
    if (real.checkedAt !== covered) fail('покрытие не совпадает с описью порции');
    const state = isRoot ? '/var/lib/fifth-monitor' : ROOT;
    fs.writeFileSync(
      path.join(state, `audit-offsite-${envId}.json`),
      `${JSON.stringify({ at: new Date().toISOString(), seq: Number(seq), coveredUntil: covered })}\n`,
    );
  }
} else if (command === 'latest') {
  if (id !== undefined) fail('лишние аргументы');
  const sets = path.join(ROOT, 'sets');
  const found = fs
    .readdirSync(sets)
    .filter((s) => SET_ID.test(s) && fs.existsSync(path.join(sets, s, 'READY')))
    .sort()
    .pop();
  if (found) console.log(found);
} else if (command === 'has') {
  console.log(readySet(id));
} else if (command === 'catalog') {
  process.stdout.write(fs.readFileSync(path.join(ROOT, 'sets', readySet(id), 'catalog.json')));
} else if (command === 'tar') {
  readySet(id);
  const catalog = catalogOf(id);
  if (catalog.id !== id || !Array.isArray(catalog.manifest)) fail('опись не от этого комплекта');
  const files = [
    ...catalog.manifest.map((m) => m.path),
    `sets/${id}/catalog.json`,
    `sets/${id}/READY`,
  ].map(checked);
  const tar = spawn(
    TAR,
    ['--no-recursion', '--verbatim-files-from', '--null', '-cf', '-', '-T', '-'],
    { cwd: ROOT, stdio: ['pipe', 'inherit', 'inherit'] },
  );
  tar.stdin.end(files.join('\0') + '\0');
  tar.on('close', (code) => process.exit(code === null ? 1 : code));
} else if (command === 'openbao-keys' || command === 'openbao-keys-meta') {
  if (id !== undefined) fail('лишние аргументы');
  const name = command === 'openbao-keys' ? 'emergency.gpg' : 'meta.json';
  process.stdout.write(fs.readFileSync(path.join(ROOT, checked(`openbao-keys/${name}`))));
} else if (command === 'transition-kit' || command === 'transition-kit-meta') {
  if (id !== undefined) fail('лишние аргументы');
  const name = command === 'transition-kit' ? 'transition.gpg' : 'transition.json';
  process.stdout.write(fs.readFileSync(path.join(ROOT, checked(`openbao-keys/${name}`))));
} else {
  fail(
    'команды: latest, has, catalog, tar, openbao-keys, openbao-keys-meta, transition-kit, transition-kit-meta, audit-list, audit-file, audit-ack',
  );
}
