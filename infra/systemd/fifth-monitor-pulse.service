# Наблюдение 5Э (блок 8, 2.1-W08a): пульс внешнему наблюдателю — только при свежей работе Zabbix.
[Unit]
Description=5E monitor: pulse
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/unicorn-launch
ExecStart=/usr/bin/node scripts/monitor-pulse.mjs
TimeoutStartSec=50
