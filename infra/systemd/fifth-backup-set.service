# Резервирование 5Э (блок 7, 2.1-W07): комплект на момент T (файлы, ключи, конфигурация).
# Запускается таймером systemd, не ядром: сбой ядра не выключает резервирование.
[Unit]
Description=5E backup: set
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/fifth-element
ExecStart=/usr/bin/node scripts/backup.mjs set
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
