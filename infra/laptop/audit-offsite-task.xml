<?xml version="1.0" encoding="UTF-8"?>
<!--
  Вынос выгрузки журнала аудита с сервера (2.1.5): раз в час, пока Томас вошёл в систему.
  НЕ установлено. Ставится только по согласованию с Томасом:
    schtasks /Create /TN "5E audit offsite" /XML infra\laptop\audit-offsite-task.xml
  Проверка работы: node scripts/audit-offsite.mjs check
  Снять: schtasks /Delete /TN "5E audit offsite" /F
  Два часа — целевая задержка при доступном ноутбуке, не гарантия: выключенный ноутбук
  виден по сигналу audit-offsite (дольше 3 ч без выноса).
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>5E: вынос выгрузки журнала аудита с сервера (scripts/audit-offsite.mjs pull)</Description>
  </RegistrationInfo>
  <Triggers>
    <TimeTrigger>
      <Repetition>
        <Interval>PT1H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-11-09T00:20:00</StartBoundary>
      <Enabled>true</Enabled>
    </TimeTrigger>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <Delay>PT5M</Delay>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Enabled>true</Enabled>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>node</Command>
      <Arguments>scripts/audit-offsite.mjs pull</Arguments>
      <WorkingDirectory>D:\Programming\fifth-element</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
