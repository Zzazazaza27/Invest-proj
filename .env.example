# ============================================================================
# Пятый элемент — образец переменных окружения.
#
# Скопируй в .env (он в .gitignore) и заполни. НИ ОДНОГО реального секрета
# в этом файле быть не должно — здесь только имена и безопасные плейсхолдеры.
#
# В production значения приходят из Vault/KMS через External Secrets; .env
# используется только локально и в CI (там — из GitHub Secrets).
# Приложение падает на старте, если обязательная переменная не задана
# (fail-closed, apps/core/src/config/env.schema.ts).
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Порты стенда ---------------------------------------------------------
# Единственное место, где задаются порты. Их читают `vite.config.ts` пяти
# фронтендов, `infra/docker-compose.yml` и скрипты проверки
# (`scripts/lib/ports.mjs`). Раньше числа были зашиты в 14 файлов сразу, и
# конфликт порта на машине разработчика чинился правкой каждого; рассинхрон
# при этом не сообщал об ошибке, а выглядел как «фронтенд не отвечает».
#
# Значения ниже — исходные порты проекта. Заняты на машине или стенд переезжает
# на другой хост — меняется только этот файл.
#
# ВАЖНО: порты БД и Redis относятся к ХОСТУ. Внутри сети контейнеров адреса
# всегда 5432/6379, и менять их здесь не нужно. Сменив POSTGRES_PORT, поправь
# порт и во всех DATABASE_URL_* ниже — это разные строки одного и того же.
WEB_PUBLIC_PORT=5173
ADMIN_PORT=5174
LAB_PORT=5175
INVESTOR_PORT=5176
# Служебная консоль разработки и тестирования. В production не публикуется.
CONSOLE_PORT=5178
# Вход и регистрация — общий экран для всех ролей.
AUTH_PORT=5179
# Обратный прокси: единая точка входа без портов в адресе.
WEB_PORT=80
POSTGRES_PORT=5433
REDIS_PORT=6380
NATS_PORT=4222

# Брокер для разрушительных проверок: свои порты и том, профиль `testing`.
# Обычный стенд его не поднимает.
NATS_TEST_PORT=4223
NATS_TEST_MONITOR_PORT=8223
NATS_MONITOR_PORT=8222
S3_PORT=9000
KEYCLOAK_PORT=8081
SMTP_PORT=1025
SMTP_UI_PORT=8025

# --- Core API -------------------------------------------------------------
CORE_BIND_HOST=127.0.0.1
CORE_PORT=4300
CORE_PUBLIC_URL=http://localhost:4300
# Разрешённые Origin для CORS. Строгий allowlist, без '*'.
# Для браузера localhost и 127.0.0.1 — РАЗНЫЕ сайты: фронтенд, открытый по
# одному имени, не получит ответа от API, разрешившего другое. В dev в списке
# оба варианта; в production origin ровно один и настоящий.
# Адреса прокси, чьим X-Forwarded-* можно верить (через запятую, CIDR).
# Пусто — прокси нет: адрес клиента берётся из соединения.
TRUSTED_PROXY_CIDRS=
# mTLS Integration API: имя заголовка с отпечатком клиентского сертификата от
# терминирующего прокси. Пусто — проверка выключена (dev без прокси). В
# production обязателен, и заголовку верят ТОЛЬКО когда непосредственный пир
# соединения входит в TRUSTED_PROXY_CIDRS (Ф36, SEC-CRIT-03) — иначе клиент,
# дотянувшийся до ядра напрямую, вписал бы отпечаток сам.
# INTEGRATION_CLIENT_CERT_HEADER=x-client-cert-fingerprint
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:5176,http://127.0.0.1:5177,http://localhost:5178,http://127.0.0.1:5178,http://localhost,http://127.0.0.1,http://localhost:5179,http://127.0.0.1:5179

# --- PostgreSQL -----------------------------------------------------------
# ВАЖНО: роль приложения НЕ владелец схем и БЕЗ BYPASSRLS.
DATABASE_URL=postgres://app_backend_user:CHANGE_ME@localhost:5433/fifth_element
DATABASE_URL_OWNER=postgres://unicorn_owner:CHANGE_ME@localhost:5433/fifth_element
DATABASE_URL_TEST=postgres://unicorn_owner:CHANGE_ME@localhost:5433/fifth_element_test
# Интеграционный контур: у роли app_integration нет доступа к схеме identity —
# наружу уходит только то, что разрешено скоупом.
# Пусто — Integration API недоступен.
DATABASE_URL_APP_INTEGRATION=postgres://app_integration_user:CHANGE_ME@localhost:5433/fifth_element

# Свой ключ подписи сервисных токенов Integration API (не ключ сессий).
# Минимум 64 символа (LOCAL_KEY_MIN_LENGTH, apps/core/src/config/env.ts) —
# короче ядро не стартует.
INTEGRATION_TOKEN_SIGNING_KEY=CHANGE_ME_минимум_64_символа_собственный_ключ_интеграции_не_короче

# Контур доставки уведомлений: шаблоны и статусы отправки.
DATABASE_URL_APP_NOTIFICATIONS=postgres://app_notifications_user:CHANGE_ME@localhost:5433/fifth_element
# Рубеж сессий и реестр отозванных токенов (M046): AuthGuard проверяет каждый
# аутентифицированный запрос под этой ролью. Не задана — /v1/auth/me отвечает
# 500, в логе «Сервисная роль app_auth не настроена».
DATABASE_URL_APP_AUTH=postgres://app_auth_user:CHANGE_ME@localhost:5433/fifth_element
# Плановое обслуживание: уборка реестра отозванных токенов и брошенных
# билетов на загрузку. Отдельная роль, а не «та, у которой подошли права» (M039).
DATABASE_URL_APP_MAINTENANCE=postgres://app_maintenance_user:CHANGE_ME@localhost:5433/fifth_element
# Выгрузка журнала в архив (scripts/archive-events.mjs): не владелец (M052).
DATABASE_URL_APP_RELEASE=postgres://app_release_user:CHANGE_ME_release@localhost:5433/fifth_element
DATABASE_URL_APP_ARCHIVE=postgres://app_archive_user:CHANGE_ME_archive@localhost:5433/fifth_element
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Пароли служебных ролей БД (создаются миграцией M000).
# Плейсхолдеры РАЗЛИЧИМЫ намеренно: у каждого секрета — своё значение, копия
# примера «как есть» не должна дать общий пароль на несколько служб
# (гейт: scripts/check-secret-reuse.mjs).
DB_ROLE_PASSWORD_APP_BACKEND=CHANGE_ME_backend
DB_ROLE_PASSWORD_APP_PUBLIC_READ=CHANGE_ME_public_read
DB_ROLE_PASSWORD_APP_NOTIFICATIONS=CHANGE_ME_notifications
DB_ROLE_PASSWORD_APP_INTEGRATION=CHANGE_ME_integration
DB_ROLE_PASSWORD_APP_READONLY=CHANGE_ME_readonly
# Чтение рубежа сессий и реестра отозванных токенов (M046).
DB_ROLE_PASSWORD_APP_AUTH=CHANGE_ME_auth_state_min_24_chars
# Плановое обслуживание: уборка реестра отзывов и брошенных билетов (M039).
DB_ROLE_PASSWORD_APP_MAINTENANCE=CHANGE_ME_maintenance_min_24_chars
# Выгрузка журнала в архив: чтение журнала + append-only реестр (M052).
DB_ROLE_PASSWORD_APP_ARCHIVE=CHANGE_ME_archive_min_24_chars
DB_ROLE_PASSWORD_APP_RELEASE=CHANGE_ME_release_min_24_chars

# Пароль локальной тестовой учётки (scripts/dev-seed-test-user.mjs).
# Только для разработки; в репозитории не хранится, в production не создаётся.
DEV_TEST_USER_PASSWORD=CHANGE_ME_dev_test_user

# --- Инфраструктура локального контура ------------------------------------
POSTGRES_PASSWORD=local_dev_only_pg_change_me
REDIS_PASSWORD=local_dev_only_redis_change_me
NATS_PASSWORD=local_dev_only_nats_change_me
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=local_dev_only_kc_change_me
# Пароль СВОЕЙ роли БД для Keycloak: до Ф45 IdP ходил в кластер под
# unicorn_owner — владельцем всех схем платформы, включая регулируемый контур.
KEYCLOAK_DB_PASSWORD=local_dev_only_kc_db_change_me

# Общий счётчик ограничения частоты. Учётные данные — ОТДЕЛЬНО от адреса:
# пароль внутри URL попадает в логи подключения и в тексты ошибок.
# В production обязателен rediss:// (TLS) и непустой REDIS_PASSWORD.
REDIS_URL=redis://localhost:6380
NATS_URL=nats://127.0.0.1:4222
# Учётные данные брокера — отдельно от адреса: пароль внутри URL попадает
# в логи подключения и в тексты ошибок как есть.
NATS_USER=unicorn
NATS_STREAM=LAUNCH

# --- S3: хранилище Garage (D-001; переход с MinIO — docs/architecture/garage-migration-plan.md)
# S3 API первого узла Garage на петле (порт прежнего MinIO — адрес у ядра и
# Caddy не меняется); узлы, бакеты и ключи — scripts/garage-init.mjs.
S3_ENDPOINT=http://localhost:9000
# Публичный адрес загрузки — куда браузер отправляет форму (2.1-W06). Локально
# не нужен: браузер и хранилище на одной машине. На внешнем стенде обязателен,
# иначе ядро форму не выдаёт: S3_PUBLIC_ENDPOINT=https://files.5espace.com
S3_PUBLIC_ENDPOINT=
S3_REGION=ru-central1
S3_BUCKET=fifth-element
# Ключи Garage — формат GK + 24 hex, секрет 64 hex; garage-init заводит их
# и права. Ключ ПРИЛОЖЕНИЯ: чтение и запись только своего бакета.
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=CHANGE_ME_64_hex_app
# Архив журнала событий (scripts/archive-events.mjs) — отдельный бакет со
# своим ключом: у Garage нет политик по префиксу, а право записи включает
# удаление (D-001).
ARCHIVE_S3_BUCKET=fifth-element-archive
ARCHIVE_S3_ACCESS_KEY_ID=GK000000000000000000000001
ARCHIVE_S3_SECRET_ACCESS_KEY=CHANGE_ME_64_hex_archive
# CORS бакета файлов — сайты, с которых браузер шлёт форму (вторая линия;
# на VPS правило держит Caddy files.<домен>).
S3_CORS_ALLOW_ORIGIN=http://127.0.0.1,http://localhost
# Garage: секрет связи узлов (64 hex) и токен admin API — только в .env.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
# До окна переноса на VPS — 3900 (рядом с MinIO), после — 9000.
GARAGE_S3_PORT=9000
GARAGE_ADMIN_PORT=3903
S3_FORCE_PATH_STYLE=true
# TTL presigned-ссылок: общий ≤15 мин, DealRoom ≤5 мин (Architect.md §5)
S3_PRESIGN_TTL_SECONDS=900
S3_PRESIGN_TTL_SENSITIVE_SECONDS=300
# Срок формы загрузки материала: предел ожидания начала и всей передачи (2.1.2).
MATERIAL_UPLOAD_FORM_TTL_SECONDS=5700

# --- Identity / OIDC ------------------------------------------------------
# AUTH_MODE=oidc — единственный допустимый режим в production.
# AUTH_MODE=local — локальный адаптер для dev/CI; приложение ОТКАЗЫВАЕТСЯ
# стартовать с ним при NODE_ENV=production (см. ADR-003).
AUTH_MODE=local
OIDC_ISSUER=http://localhost:8081/realms/fifth-element
OIDC_AUDIENCE=fifth-core
OIDC_CLIENT_ID=fifth-core
OIDC_CLIENT_SECRET=CHANGE_ME_oidc_client
OIDC_JWKS_CACHE_TTL_SECONDS=300

# Ключ подписи локального dev-адаптера (только AUTH_MODE=local).
# Минимум 64 символа. В production переменная игнорируется.
LOCAL_AUTH_SIGNING_KEY=CHANGE_ME_local_dev_only_at_least_64_chars_long_random_string_here
SESSION_COOKIE_NAME=ul_session
SESSION_TTL_SECONDS=3600
CSRF_COOKIE_NAME=ul_csrf

# Ключ подписи CSRF-токенов: токен связывается с сессией, а не просто дублируется.
# Минимум 64 символа (LOCAL_KEY_MIN_LENGTH, apps/core/src/config/env.ts) —
# короче ядро не стартует.
CSRF_SIGNING_KEY=CHANGE_ME_минимум_64_символа_свой_ключ_csrf_токенов_не_короче_порога
# Версии подписей, так же для LOCAL_AUTH_SIGNING_KEY и INTEGRATION_TOKEN_SIGNING_KEY.
# VERSIONS: kid:секрет через запятую. ACTIVE: версия новых токенов, пусто — прежний формат без kid.
# LEGACY_UNTIL: срок приёма токенов без kid, обязателен при ACTIVE. Порядок: docs/runbooks/openbao.md.
CSRF_SIGNING_KEY_VERSIONS=
CSRF_SIGNING_KEY_ACTIVE=
CSRF_SIGNING_KEY_LEGACY_UNTIL=
LOCAL_AUTH_SIGNING_KEY_VERSIONS=
LOCAL_AUTH_SIGNING_KEY_ACTIVE=
LOCAL_AUTH_SIGNING_KEY_LEGACY_UNTIL=
INTEGRATION_TOKEN_SIGNING_KEY_VERSIONS=
INTEGRATION_TOKEN_SIGNING_KEY_ACTIVE=
INTEGRATION_TOKEN_SIGNING_KEY_LEGACY_UNTIL=

# --- Криптография (envelope encryption) -----------------------------------
# KMS_MODE=kms — OpenBao Transit, KEK ядру не выдаётся: при нём переменные KEK_* должны быть пусты.
# KMS_MODE=local — dev: KEK берутся из переменных ниже.
KMS_MODE=local
# Формат новых записей, отдельно от режима ключей. legacy читает и прежний выпуск.
# vault — граница возврата, только при KMS_MODE=kms. Порядок: docs/runbooks/openbao.md.
CRYPTO_WRITE_FORMAT=legacy
OPENBAO_ADDR=
OPENBAO_CA_PATH=
# Файл с токеном: его пишет и продлевает OpenBao Agent.
OPENBAO_TOKEN_PATH=
OPENBAO_KEY_PREFIX=prod
# Версия ключа поиска. Смена означает пересчёт индексов, сама не включается.
OPENBAO_SEARCH_INDEX_VERSION=1
OPENBAO_TIMEOUT_MS=3000
KMS_ENDPOINT=
# Корневые ключи KEK по доменам. 32 байта в base64. Каждому домену — СВОЙ ключ:
# общий ключ на домены обнуляет смысл раздельной ротации.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEK_KYC_DOCUMENTS=CHANGE_ME_base64_32_bytes_kyc
KEK_KYB_DOCUMENTS=CHANGE_ME_base64_32_bytes_kyb
KEK_PASSPORT_SENSITIVE=CHANGE_ME_base64_32_bytes_passport
# Секреты подписи вебхуков: своя область ротации, чтобы смена ключа не тянула
# за собой документы KYC.
KEK_WEBHOOK_SECRETS=CHANGE_ME_base64_32_bytes_webhook
# Ключ blind index (HMAC-SHA256 по email/телефону/ИНН). Ротация — отдельная процедура.
KEK_SEARCH_INDEX=CHANGE_ME_base64_32_bytes_search
# Домены ключей инвестиционных и денежных документов и ключей LLM-провайдеров
# удалены в 2.1-W05 вместе с их контурами.

# --- Входящие подписанные вебхуки -----------------------------------------
# Окно допустимого расхождения timestamp у входящих подписанных вебхуков.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Выпускает ли контур доставку вебхуков наружу.
#   capture — доставка не уходит, запись помечается «перехвачено» с причиной;
#   live    — обычная отправка подписчику.
# Вне production держим capture: доставка вебхуков — единственный живой канал
# платформы во внешний мир (почта локальная, платежи тестовые). Отсутствие
# рабочих данных в базе от внешнего действия не защищает.
WEBHOOK_DELIVERY_MODE=capture

# Тестовые сессии и просмотр кабинета от чужого лица (M129). В production
# механизм выключен кодом; здесь — переключатель для стенда.
TESTING_SESSIONS_ENABLED=true



# --- Каналы уведомлений ---------------------------------------------------
SMTP_URL=smtp://localhost:1025
SMTP_FROM=no-reply@5espace.com
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_DEFAULT_PER_MIN=120
# Ведро класса auth считается по адресу: в production держи низким.
RATE_LIMIT_AUTH_PER_MIN=30
# Денежного класса (money) нет с 2.1-W05: денежных операций на платформе нет.

# --- Фронтенды (Vite, префикс VITE_ обязателен) ---------------------------
# Единственная переменная, которая связывает фронт с бэком.
VITE_API_BASE_URL=http://localhost:4300/v1
# Имя CSRF-cookie для фронтендов. Читается четырьмя приложениями; рассинхрон
# с серверным CSRF_COOKIE_NAME молча ломает ВСЕ мутации (INFO аудита №2).
VITE_CSRF_COOKIE_NAME=ul_csrf

# Административные операции: отдельный класс лимита (см. apps/core/src/main.ts)
RATE_LIMIT_ADMIN_PER_MIN=60
# Потолок частоты по адресу поверх классовых вёдер: закрывает обход
# классового ведра подделкой подсказки сессии в cookie.
RATE_LIMIT_IP_CEILING_PER_MIN=600
# Троттлинг перебора пароля НА АККАУНТ (Ф40): порог неудач за окно, после
# которого вход отклоняется до argon2. Считается по blind-индексу контакта,
# поэтому смена адреса счётчик не сбрасывает; успешный вход обнуляет.
RATE_LIMIT_LOGIN_FAIL_PER_ACCOUNT=10
LOGIN_THROTTLE_WINDOW_SEC=900

# --- Почта: восстановление пароля, подтверждение адреса, служебный ящик ---
# none — отправлять нечем, маршруты отвечают 503 feature_disabled.
# file — письмо кладётся файлом в MAIL_OUTBOX_DIR. Не доставка, а способ
#        пройти сценарий целиком на стенде; в production запрещено конфигурацией.
# smtp — настоящая доставка через smarthost (MAIL_SMTP_* ниже).
MAIL_TRANSPORT=none
MAIL_OUTBOX_DIR=var/mail
MAIL_FROM=no-reply@fifth.local

# Релей для MAIL_TRANSPORT=smtp.
#
# Свой почтовый сервер на текущем ВПС отправлять не может: исходящие 25, 465 и
# 587 закрыты провайдером ко всем проверенным MX (проверено с сервера
# 2026-08-24). Открыт 2525 — его и держат почтовые провайдеры для таких
# случаев. Поэтому схема одна: smarthost провайдера с аутентификацией.
#
# starttls — открыть и обязательно перейти на TLS (587, 2525);
# tls      — TLS с первого байта (465);
# plain    — без шифрования; ТОЛЬКО на петлю и ТОЛЬКО без пароля (mailpit).
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=2525
MAIL_SMTP_SECURITY=starttls
MAIL_SMTP_USER=
# Пароль релея. Как и все секреты — не в репозитории: значение живёт в .env
# стенда и в секретах CI.
MAIL_SMTP_PASSWORD=
# Имя в EHLO. Пусто — берётся домен из MAIL_FROM.
MAIL_SMTP_EHLO_NAME=
MAIL_SMTP_TIMEOUT_MS=10000

# Слать ли на служебный ящик уведомление о каждой новой регистрации.
# По умолчанию выключено: на стенде и в нагрузочных прогонах регистраций
# тысячи, и забитый ими ящик перестают читать вместе с обращениями.
NOTIFY_INBOX_ON_REGISTRATION=false
# Служебный ящик проекта: куда падают новые обращения в поддержку и
# сообщения об ошибках. Технический адрес, не личная почта сотрудника.
# Пусто — копия не уходит, обращение всё равно сохраняется и видно в
# интерфейсе поддержки.
SUPPORT_INBOX_EMAIL=support@fifth.local
# Из этого адреса собираются ссылки в письмах. Заголовок Host для этого не
# годится: подменённый, он увёл бы ссылку смены пароля на чужой домен.
PUBLIC_BASE_URL=http://127.0.0.1
PASSWORD_RESET_TTL_SEC=1800
EMAIL_VERIFY_TTL_SEC=86400
RATE_LIMIT_VERIFY_MAIL_PER_CONTACT=5
VERIFY_MAIL_WINDOW_SEC=3600

# --- Резервирование (блок 7, 2.1-W07; docs/runbooks/backup.md) ---
# Каталог копий на узле. На сервере: /var/backups/fifth-element.
BACKUP_DIR=
# Хранилище pgBackRest = BACKUP_DIR/pgbackrest (монтируется в контейнер базы).
BACKUP_PGBACKREST_DIR=
# Архив журнала базы: on — только там, где резервирование настроено.
BACKUP_ARCHIVE_MODE=off
# Секреты — `node scripts/backup.mjs init-secrets` дописывает их сам.
BACKUP_PGBACKREST_CIPHER_PASS=
BACKUP_FILES_CRYPT_PASS=
BACKUP_FILES_CRYPT_SALT=
# Ключ копий W07 в хранилище — только чтение (Garage: GK + 24 hex).
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Хранилище-источник копий в сети стенда: Garage — http://garage-1:3900
# (MinIO до переключения — http://minio:9000). Меняется только в окне.
BACKUP_S3_SOURCE_ENDPOINT=http://garage-1:3900
# Открытый ключ Томаса для комплекта ключей (по умолчанию BACKUP_DIR/recipient.asc).
BACKUP_KEYS_RECIPIENT=
# Сигналы о сбоях. Пусто — сигналы только в журнале (и это видно в check).
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
# Пороги места: предупреждение и запас, без которого задание не начинается.
BACKUP_DISK_WARN_PERCENT=25
BACKUP_DISK_RESERVE_PERCENT=15
BACKUP_DISK_RESERVE_MIN_GB=10

# --- Наблюдение (блок 8, 2.1-W08a; docs/runbooks/monitoring.md) ---
# local — стенд разработчика; vps — сервер (агент в сети узла).
MONITOR_ENV=local
ZABBIX_HOST_NAME=5e-stand
# Состояние контейнеров для агента (пишет scripts/monitor-export.mjs).
MONITOR_STATE_DIR=
ZABBIX_WEB_PORT=8090
# Адрес сервера Zabbix для веб-интерфейса. VPS: host.docker.internal (сервер в
# сети узла, zabbix-server-host). Стенд: пусто (zabbix-server).
ZABBIX_WEB_SERVER_HOST=
ZABBIX_DB_PASSWORD=
ZABBIX_MONITOR_DB_PASSWORD=
ZABBIX_ADMIN_PASSWORD=
# Дописывает monitoring.mjs configure.
ZABBIX_PULSE_API_TOKEN=
# Адрес пинга Healthchecks.io — секрет.
HEALTHCHECKS_PING_URL=
# Каталог публичного пульса /_pulse.json (время и итог проверки Zabbix) для
# внешней проверки rebel-diesel/scripts 5e_watch. VPS: /var/lib/fifth-monitor/public.
MONITOR_PULSE_PUBLIC_DIR=
# Закреплённый IP для публичных проверок на время отказа DNS (deploy,
# monitor-app-probe, monitor-probe-disable): имя=IPv4 через запятую. Host, SNI
# и сертификат — по имени. Успех по нему НЕ подтверждает доступность по имени.
# В обычной работе — пусто.
PUBLIC_PIN=
# Служебный порт ядра для агента в Docker на машине разработчика.
# На VPS не задавать: по умолчанию 127.0.0.1.
CORE_INTERNAL_BIND_HOST=127.0.0.1
# Служебная учётка мониторинга (2.5): пароль — monitor-probe-init.mjs.
CONTROL_PROBE_PASSWORD=
# Публичный адрес для проверки прикладного пути (VPS: https://5espace.com).
MONITOR_PUBLIC_URL=http://127.0.0.1
# Сессия служебной учётки — вне каталога, который читает агент.
MONITOR_PRIVATE_DIR=

# --- Технические журналы (блок 8, 8.4; 2.1-W08b; docs/runbooks/w08b-vps-apply.md)
# Значения — только в .env стенда: так ключи и учётки входят в комплект ключей
# W07. Пусто — архив журналов не настроен, minio-init бакеты не заводит.
# Драйвер журналов контейнеров: на VPS journald, локально — json-file.
DOCKER_LOG_DRIVER=
LOGS_S3_ENDPOINT=
# Основной архив: бакет, учётка записи без удаления, учётка чтения, ключ
# шифрования (64 hex).
LOGS_S3_BUCKET=
LOGS_S3_ACCESS_KEY_ID=
LOGS_S3_SECRET_ACCESS_KEY=
LOGS_READER_ACCESS_KEY_ID=
LOGS_READER_SECRET_ACCESS_KEY=
LOGS_ARCHIVE_KEY=
# Накопленная история — отдельный бакет, учётки и ключ.
LOGS_LEGACY_S3_BUCKET=
LOGS_LEGACY_WRITER_ACCESS_KEY_ID=
LOGS_LEGACY_WRITER_SECRET_ACCESS_KEY=
LOGS_LEGACY_READER_ACCESS_KEY_ID=
LOGS_LEGACY_READER_SECRET_ACCESS_KEY=
LOGS_LEGACY_ARCHIVE_KEY=
# Журналы почты: пути через запятую — только существующие источники.
LOGS_FILES=
# Потолок journald (байт) для расчёта запаса в наблюдении: 4 ГиБ.
LOGS_JOURNAL_MAX_BYTES=
