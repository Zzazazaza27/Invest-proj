# ============================================================================
# UNICORN LAUNCH — образец переменных окружения.
#
# Скопируй в .env (он в .gitignore) и заполни. НИ ОДНОГО реального секрета
# в этом файле быть не должно — здесь только имена и безопасные плейсхолдеры.
#
# В production значения приходят из Vault/KMS через External Secrets; .env
# используется только локально и в CI (там — из GitHub Secrets).
# Приложение падает на старте, если обязательная переменная не задана
# (fail-closed, apps/core/src/config/env.schema.ts).
# ============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Core API -------------------------------------------------------------
CORE_BIND_HOST=127.0.0.1
CORE_PORT=4300
CORE_PUBLIC_URL=http://localhost:4300
# Разрешённые Origin для CORS. Строгий allowlist, без '*'.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177

# --- PostgreSQL -----------------------------------------------------------
# ВАЖНО: роль приложения НЕ владелец схем и БЕЗ BYPASSRLS.
DATABASE_URL=postgres://app_backend:CHANGE_ME@localhost:5433/unicorn_launch
DATABASE_URL_OWNER=postgres://unicorn_owner:CHANGE_ME@localhost:5433/unicorn_launch
DATABASE_URL_TEST=postgres://unicorn_owner:CHANGE_ME@localhost:5433/unicorn_test
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Пароли служебных ролей БД (создаются миграцией M000)
DB_ROLE_PASSWORD_APP_BACKEND=CHANGE_ME
DB_ROLE_PASSWORD_APP_PUBLIC_READ=CHANGE_ME
DB_ROLE_PASSWORD_APP_INVESTMENTS=CHANGE_ME
DB_ROLE_PASSWORD_APP_BILLING=CHANGE_ME
DB_ROLE_PASSWORD_APP_NOTIFICATIONS=CHANGE_ME
DB_ROLE_PASSWORD_APP_INTEGRATION=CHANGE_ME
DB_ROLE_PASSWORD_APP_READONLY=CHANGE_ME

# --- Инфраструктура локального контура ------------------------------------
POSTGRES_PASSWORD=local_dev_only_change_me
REDIS_PASSWORD=local_dev_only_change_me
NATS_PASSWORD=local_dev_only_change_me
MINIO_ROOT_USER=unicorn_minio
MINIO_ROOT_PASSWORD=local_dev_only_change_me
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=local_dev_only_change_me

REDIS_URL=redis://:CHANGE_ME@localhost:6380
NATS_URL=nats://unicorn:CHANGE_ME@localhost:4222
NATS_STREAM=LAUNCH

# --- S3 (в production — российский регион, Object Lock/WORM для бэкапов) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=unicorn-launch
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
# TTL presigned-ссылок: общий ≤15 мин, DealRoom ≤5 мин (Architect.md §5)
S3_PRESIGN_TTL_SECONDS=900
S3_PRESIGN_TTL_SENSITIVE_SECONDS=300

# --- Identity / OIDC ------------------------------------------------------
# AUTH_MODE=oidc — единственный допустимый режим в production.
# AUTH_MODE=local — локальный адаптер для dev/CI; приложение ОТКАЗЫВАЕТСЯ
# стартовать с ним при NODE_ENV=production (см. ADR-003).
AUTH_MODE=local
OIDC_ISSUER=http://localhost:8081/realms/unicorn-launch
OIDC_AUDIENCE=unicorn-launch-core
OIDC_CLIENT_ID=unicorn-launch-core
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_JWKS_CACHE_TTL_SECONDS=300

# Ключ подписи локального dev-адаптера (только AUTH_MODE=local).
# Минимум 64 символа. В production переменная игнорируется.
LOCAL_AUTH_SIGNING_KEY=CHANGE_ME_local_dev_only_at_least_64_chars_long_random_string_here
SESSION_COOKIE_NAME=ul_session
SESSION_TTL_SECONDS=3600
CSRF_COOKIE_NAME=ul_csrf

# --- Криптография (envelope encryption) -----------------------------------
# KMS_MODE=kms — production (внешний KMS/Vault Transit).
# KMS_MODE=local — dev: KEK берутся из переменных ниже.
KMS_MODE=local
KMS_ENDPOINT=
# Корневые ключи KEK по доменам. 32 байта в base64.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEK_KYC_DOCUMENTS=CHANGE_ME_base64_32_bytes
KEK_KYB_DOCUMENTS=CHANGE_ME_base64_32_bytes
KEK_PASSPORT_SENSITIVE=CHANGE_ME_base64_32_bytes
KEK_INVESTMENT_DOCUMENTS=CHANGE_ME_base64_32_bytes
KEK_NOMINAL_ACCOUNT_EVIDENCE=CHANGE_ME_base64_32_bytes
KEK_BILLING_DOCUMENTS=CHANGE_ME_base64_32_bytes
# Ключ blind index (HMAC-SHA256 по email/телефону/ИНН). Ротация — отдельная процедура.
KEK_SEARCH_INDEX=CHANGE_ME_base64_32_bytes

# --- AI-контур ------------------------------------------------------------
AI_GATEWAY_URL=http://localhost:8100
AI_GATEWAY_TOKEN=CHANGE_ME
AI_GATEWAY_TIMEOUT_MS=30000
# Юрисдикционная политика роутинга LLM. Отсутствует/не проходит валидацию → hard fail.
AI_POLICY_PATH=./apps/ai-gateway/policy/jurisdiction-routing.yaml
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Платёжный провайдер и банк номинального счёта -------------------------
# Значения утверждаются до этапа L3 (Architect_Launch.md §10).
PAYMENT_PROVIDER=stub
PAYMENT_PROVIDER_WEBHOOK_SECRET=CHANGE_ME
NOMINAL_ACCOUNT_BANK=stub
NOMINAL_ACCOUNT_WEBHOOK_SECRET=CHANGE_ME
# Окно допустимого расхождения timestamp у входящих подписанных вебхуков.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# --- Каналы уведомлений ---------------------------------------------------
SMTP_URL=smtp://localhost:1025
SMTP_FROM=no-reply@unicorn.vc
TELEGRAM_BOT_TOKEN=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=30
# Класс money — 10 запросов в минуту (Architect_Launch.md §7).
# Класс auth мягче: 10/мин не переживает легитимную последовательность
# регистрация → вход → повтор при опечатке. Спецификация задаёт 10/мин
# именно для денежных операций.
RATE_LIMIT_MONEY_PER_MIN=10

# --- Фронтенды (Vite, префикс VITE_ обязателен) ---------------------------
# Единственная переменная, которая связывает фронт с бэком.
VITE_API_BASE_URL=http://localhost:4300/v1

# Административные операции: отдельный класс лимита (см. apps/core/src/main.ts)
RATE_LIMIT_ADMIN_PER_MIN=60
